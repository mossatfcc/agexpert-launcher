  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onUri"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agexpert.launcher.launch",
        "title": "AgExpert: Launch App Terminals"
      }
    ]
  }
}




