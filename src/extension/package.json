{
  "name": "launcher",
  "displayName": "AgExpert Launcher",
  "description": "Opens dedicated integrated-terminal tabs for AgExpert web apps, APIs, and the environment proxy.",
  "publisher": "agexpert",
  "version": "0.2.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mosss/agexpert-launcher.git"
  },
  "engines": {
